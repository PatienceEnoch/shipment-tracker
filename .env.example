ALERT_EMAIL_TO=alerts@example.com
ALERT_EMAIL_FROM=shipments@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=shipments@example.com
SMTP_PASSWORD=replace-me

EMAIL_DRY_RUN=true
ALERT_CHECK_INTERVAL_SECONDS=300

GMAIL_INTAKE_ENABLED=false
GMAIL_INTAKE_ADDRESS=yourname+shipments@gmail.com
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
GMAIL_CHECK_INTERVAL_SECONDS=60
